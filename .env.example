# Optional local defaults for Folionym.
# Copy this file to .env only when your shell or process manager loads dotenv files.

# Local OpenAI-compatible LLM endpoint. The default preset uses local Ollama.
FOLIONYM_LLM_URL=http://127.0.0.1:11434/v1/completions
FOLIONYM_LLM_MODEL=qwen2.5:3b
# FOLIONYM_LLM_TIMEOUT=60

# Keep remote endpoints encrypted. Set to 1 when using any non-loopback LLM URL.
FOLIONYM_REQUIRE_HTTPS=0

# Optional local runtime paths.
# FOLIONYM_CACHE_DIR=/path/to/local/cache
# FOLIONYM_DATA_DIR=/path/to/folionym-data
# FOLIONYM_LOG_FILE=/path/to/folionym.log
# FOLIONYM_LOG_LEVEL=INFO
# FOLIONYM_STRUCTURED_LOGS=0

# Optional extraction/runtime tuning.
# FOLIONYM_MAX_TOKENS=28000
# FOLIONYM_MAX_CONTENT_CHARS=120000
# FOLIONYM_MAX_CONTENT_TOKENS=28000
# FOLIONYM_OCR_LANG=deu
# FOLIONYM_USE_VISION_FALLBACK=0
# FOLIONYM_VISION_FIRST=0

# Optional post-rename notification endpoint. Non-loopback endpoints require HTTPS.
# FOLIONYM_POST_RENAME_HOOK=https://example.invalid/hooks/folionym
