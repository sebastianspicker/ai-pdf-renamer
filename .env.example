# Optional local defaults for ai-pdf-renamer.
# Copy to .env only if your shell or process manager loads dotenv files.

# Local OpenAI-compatible LLM endpoint. The default preset uses local Ollama.
AI_PDF_RENAMER_LLM_URL=http://127.0.0.1:11434/v1/completions
AI_PDF_RENAMER_LLM_MODEL=qwen2.5:3b
AI_PDF_RENAMER_LLM_BACKEND=http

# Keep remote endpoints encrypted. Set to 1 when using any non-loopback LLM URL.
AI_PDF_RENAMER_REQUIRE_HTTPS=0

# Optional local runtime paths.
# AI_PDF_RENAMER_CACHE_DIR=/path/to/local/cache
# AI_PDF_RENAMER_LOG_FILE=/path/to/ai-pdf-renamer.log

# Optional extraction/runtime tuning.
# AI_PDF_RENAMER_MAX_TOKENS=28000
# AI_PDF_RENAMER_MAX_CONTENT_CHARS=120000
# AI_PDF_RENAMER_OCR_LANG=deu
