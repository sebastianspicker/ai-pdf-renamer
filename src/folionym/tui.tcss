Screen {
    layout: vertical;
    background: $background;
    color: $foreground;
}

#brand-bar {
    height: 3;
    min-height: 3;
    background: $background;
    border-bottom: solid $quiet-border;
}

#brand-name {
    width: 1fr;
    height: 1fr;
    padding: 0 2;
    content-align: left middle;
    color: $foreground;
    text-style: bold;
}

#current-scope {
    width: 1fr;
    height: 1fr;
    padding: 0 2;
    content-align: center middle;
    color: $muted-copy;
}

#trust-state {
    width: 1fr;
    height: 1fr;
    padding: 0 2;
    content-align: right middle;
    color: $success;
}

#app-workspace {
    height: 1fr;
}

#workflow-header {
    width: 1fr;
    height: 5;
    padding: 0 2;
    background: $background;
    border-bottom: solid $quiet-border;
}

.workflow-nav {
    width: 1fr;
    height: 4;
    min-width: 1;
    margin: 0;
    padding: 0 2;
    content-align: center middle;
    background: $background;
    color: $muted-copy;
    border: none;
}

.workflow-nav:hover {
    background: $surface;
    color: $foreground;
}

.workflow-nav:focus {
    background: $background;
    color: $foreground;
    border-bottom: solid $primary;
}

.workflow-nav.active {
    background: $background;
    color: $foreground;
    text-style: bold;
    border-bottom: solid $primary;
}

#workflow-tabs {
    width: 1fr;
    height: 1fr;
}

ContentTabs {
    display: none;
    background: $background;
    border-bottom: solid $quiet-border;
}

Tab.-active {
    color: $foreground;
    text-style: bold;
}

TabPane {
    padding: 0;
}

Input {
    height: 3;
    color: $foreground;
    background: $background;
    border: tall $quiet-border;
}

Input:hover {
    border: tall $strong-border;
}

Input:focus {
    border: tall $primary;
}

Input.-invalid {
    border: tall $error;
    background: $error-soft;
}

Select {
    height: 3;
    color: $foreground;
    background: transparent;
    border: none;
}

Select > SelectCurrent {
    height: 3;
    color: $foreground;
    background: $background;
    border: tall $quiet-border;
}

Select > SelectCurrent.-has-value Static#label {
    color: $foreground;
}

Select:hover > SelectCurrent {
    border: tall $strong-border;
}

Select:focus > SelectCurrent {
    background: $selection-soft;
    border: tall $primary;
}

Select > SelectOverlay {
    color: $foreground;
    background: $background;
    border: tall $strong-border;
}

Checkbox {
    height: 3;
    padding: 0 1;
    color: $foreground;
    background: $background;
    border: none;
}

Checkbox:hover {
    background: $surface;
}

Checkbox:focus {
    background: $selection-soft;
    color: $foreground;
    text-style: bold;
}

Button {
    color: $foreground;
    background: $background;
    border: tall $strong-border;
}

Button:hover {
    color: $foreground;
    background: $surface;
    border: tall $foreground;
}

Button:focus {
    color: $foreground;
    background: $selection-soft;
    border: tall $primary;
    text-style: bold;
}

Button:disabled {
    color: $muted-copy;
    background: $surface;
    border: tall $quiet-border;
    text-opacity: 55%;
}

#rename-rail {
    height: auto;
    min-height: 3;
    margin-bottom: 1;
    padding: 1 2;
    background: $selection-soft;
    border: solid $quiet-border;
    color: $foreground;
}

.section-note {
    height: auto;
    margin: 0 0 1 0;
    color: $muted-copy;
}

#setup-error {
    display: none;
    height: auto;
    margin-bottom: 1;
    padding: 1 2;
    color: $error;
    background: $error-soft;
    border: solid $error;
}

#setup-error.visible {
    display: block;
}

.field-row {
    height: auto;
    margin-bottom: 1;
    layout: horizontal;
}

.field-label {
    width: 24;
    padding: 0 1 0 0;
    content-align: left middle;
    color: $foreground;
}

.field-input {
    width: 1fr;
}

.section-title {
    height: auto;
    padding: 1 0 0 0;
    color: $foreground;
    text-style: bold;
}

.section-sep {
    height: 1;
    border-top: solid $quiet-border;
    margin: 1 0;
}

.flags-row {
    height: auto;
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-gutter: 0 2;
}

.flag-check {
    width: 1fr;
}

.form-container {
    padding: 1 2;
}

#run-tab {
    layout: vertical;
}

#review-workspace {
    height: 1fr;
    padding: 1 2 0 2;
}

#preview-pane {
    width: 2fr;
    height: 1fr;
    padding: 0 2 0 0;
}

#review-inspector {
    width: 36;
    height: 1fr;
    padding: 1 2;
    background: $surface;
    border-left: solid $quiet-border;
}

#run-status-bar {
    height: 3;
    layout: horizontal;
    border-bottom: solid $quiet-border;
}

#review-title {
    width: 1fr;
    height: 2;
    content-align: left middle;
    color: $foreground;
    text-style: bold;
}

#run-status {
    width: auto;
    height: 2;
    color: $muted-copy;
    content-align: right middle;
}

#run-status.status-running,
#run-status.status-cancel {
    color: $warning;
    text-style: bold;
}

#run-status.status-done {
    color: $success;
    text-style: bold;
}

#run-status.status-error {
    color: $error;
    text-style: bold;
}

#run-file-counter {
    width: auto;
    height: 2;
    padding-left: 2;
    content-align: right middle;
    color: $muted-copy;
}

#review-description {
    height: 2;
    padding-top: 1;
    color: $muted-copy;
}

#run-metrics {
    height: 2;
    grid-size: 4;
    grid-columns: 1fr 1fr 1fr 1fr;
    border-bottom: solid $quiet-border;
}

.run-metric {
    height: 2;
    padding: 0 1;
    content-align: left middle;
    color: $muted-copy;
    border-right: solid $quiet-border;
}

#metric-suggestions {
    color: $success;
}

#metric-skipped {
    color: $warning;
}

#metric-failed {
    color: $error;
    border-right: none;
}

#run-progress {
    height: 1;
    margin-bottom: 1;
    color: $primary;
    background: $surface;
}

#preview-empty {
    height: 3;
    padding: 0 2;
    content-align: left middle;
    color: $muted-copy;
    background: $surface;
    border-top: solid $quiet-border;
    border-bottom: solid $quiet-border;
}

#preview-table {
    height: 1fr;
    min-height: 7;
    background: $background;
    color: $foreground;
    border-top: solid $quiet-border;
    border-bottom: solid $quiet-border;
}

#preview-table > .datatable--header {
    background: $surface;
    color: $muted-copy;
    text-style: bold;
}

#preview-table > .datatable--cursor {
    background: $selection-soft;
    color: $foreground;
}

#activity-label {
    height: 2;
    padding-top: 1;
    color: $foreground;
    text-style: bold;
}

#run-log {
    height: 6;
    min-height: 3;
    padding: 0 1;
    background: $surface;
    color: $foreground;
    border-top: solid $quiet-border;
    border-bottom: solid $quiet-border;
}

#run-summary {
    display: none;
}

.inspector-label {
    height: 2;
    padding-top: 1;
    color: $foreground;
    text-style: bold;
}

#inspector-source {
    height: 2;
    color: $foreground;
}

#inspector-proposed {
    height: auto;
    min-height: 3;
    color: $foreground;
}

#inspector-mode {
    height: auto;
    min-height: 1;
    color: $muted-copy;
}

.inspector-rule {
    height: 1;
    border-top: solid $quiet-border;
}

#privacy-disclosure {
    height: auto;
    min-height: 3;
    margin: 1 0;
    padding: 0 2;
    content-align: left middle;
    color: $success;
    background: $success-soft;
    border: solid $quiet-border;
}

#effective-config {
    height: auto;
    color: $muted-copy;
}

#run-guidance {
    height: 3;
    padding: 0 3;
    content-align: left middle;
    color: $warning;
    background: $warning-soft;
    border-top: solid $quiet-border;
}

#run-buttons {
    height: 4;
    grid-size: 4;
    grid-columns: 1fr 1fr 1fr 1fr;
    grid-gutter: 0 1;
    padding: 0 2 1 2;
}

#run-buttons Button {
    width: 1fr;
    min-width: 1;
}

#btn-preview,
#btn-one {
    color: $foreground;
    background: $background;
    border: tall $strong-border;
}

#btn-preview:focus,
#btn-one:focus {
    color: $foreground;
    background: $selection-soft;
    border: tall $primary;
}

#btn-apply {
    color: #FFFFFF;
    background: $primary;
    border: tall $primary;
}

#btn-apply:hover,
#btn-apply:focus {
    color: #FFFFFF;
    background: #1D55BC;
    border: tall #1D55BC;
}

#btn-cancel {
    color: $error;
    background: $background;
    border: tall $error;
}

#btn-cancel:hover,
#btn-cancel:focus {
    color: #FFFFFF;
    background: $error;
    border: tall $error;
}

#btn-preview:disabled,
#btn-apply:disabled,
#btn-one:disabled,
#btn-cancel:disabled {
    color: $muted-copy;
    background: $surface;
    border: tall $quiet-border;
    text-opacity: 55%;
}

Footer {
    height: 1;
    color: $muted-copy;
    background: $surface;
}

Toast {
    color: $foreground;
    background: $background;
    border: solid $quiet-border;
}

Toast.-information {
    border: solid $success;
}

Toast.-warning {
    border: solid $warning;
}

Toast.-error {
    border: solid $error;
}

Screen.compact #review-inspector,
Screen.compact #review-description,
Screen.compact #activity-label {
    display: none;
}

Screen.compact #brand-bar {
    height: 2;
    min-height: 2;
}

Screen.compact #current-scope {
    display: none;
}

Screen.compact #brand-name,
Screen.compact #trust-state {
    width: 1fr;
}

Screen.compact #workflow-header {
    height: 3;
    padding: 0 1;
}

Screen.compact .workflow-nav {
    height: 3;
    padding: 0 1;
}

Screen.compact #review-workspace {
    padding: 0 1;
}

Screen.compact #preview-pane {
    width: 1fr;
    padding: 0;
}

Screen.compact #run-status-bar {
    height: 2;
}

Screen.compact #run-metrics {
    height: 2;
}

Screen.compact .run-metric {
    height: 2;
    padding: 0 1;
}

Screen.compact #run-log {
    height: 2;
}

Screen.compact #preview-table {
    min-height: 3;
}

Screen.compact #run-guidance {
    height: 2;
    padding: 0 1;
}

Screen.compact #run-buttons {
    height: 6;
    grid-size: 2 2;
    grid-columns: 1fr 1fr;
    padding: 0 1;
}

ConfirmActionScreen {
    align: center middle;
    background: #17202D 35%;
}

#confirm-dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 3 1fr 3;
    width: 68;
    height: 16;
    padding: 1 2;
    background: $background;
    border: solid $strong-border;
}

#confirm-title,
#confirm-detail {
    column-span: 2;
    width: 1fr;
}

#confirm-title {
    color: $foreground;
    text-style: bold;
    content-align: left middle;
}

#confirm-detail {
    color: $muted-copy;
}

#confirm-dialog Button {
    width: 1fr;
}

#confirm-cancel {
    color: $foreground;
    background: $background;
    border: tall $strong-border;
}

#confirm-cancel:focus {
    color: $foreground;
    background: $selection-soft;
    border: tall $primary;
}

#confirm-action {
    color: #FFFFFF;
    background: $error;
    border: tall $error;
}

#confirm-action:hover,
#confirm-action:focus {
    color: #FFFFFF;
    background: #8F1C13;
    border: tall #8F1C13;
}
